<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_flowdesk" model="res.groups.privilege">
        <field name="name">FlowDesk</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_flowdesk_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_flowdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_flowdesk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_flowdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_flowdesk_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- C11: salespeople see only their own approval requests, managers see all -->
    <record id="rule_flowdesk_discount_approval_own" model="ir.rule">
        <field name="name">Discount approval: own requests</field>
        <field name="model_id" ref="model_flowdesk_discount_approval"/>
        <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_flowdesk_discount_approval_all" model="ir.rule">
        <field name="name">Discount approval: all (managers)</field>
        <field name="model_id" ref="model_flowdesk_discount_approval"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
</odoo>
