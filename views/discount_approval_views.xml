<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- C11: discount approval records -->
    <record id="flowdesk_discount_approval_view_form" model="ir.ui.view">
        <field name="name">flowdesk.discount.approval.form</field>
        <field name="model">flowdesk.discount.approval</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'waiting'" groups="sales_team.group_sale_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'waiting'" groups="sales_team.group_sale_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="salesperson_id"/>
                            <field name="limit"/>
                            <field name="max_discount"/>
                        </group>
                        <group>
                            <field name="approver_id"/>
                            <field name="decision_date"/>
                            <field name="comment" readonly="state != 'waiting'"
                                   placeholder="Required when rejecting"/>
                        </group>
                    </group>
                    <field name="line_detail" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="flowdesk_discount_approval_view_list" model="ir.ui.view">
        <field name="name">flowdesk.discount.approval.list</field>
        <field name="model">flowdesk.discount.approval</field>
        <field name="arch" type="xml">
            <list create="0" delete="0"
                  decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="limit"/>
                <field name="max_discount"/>
                <field name="approver_id"/>
                <field name="decision_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="flowdesk_discount_approval_view_search" model="ir.ui.view">
        <field name="name">flowdesk.discount.approval.search</field>
        <field name="model">flowdesk.discount.approval</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="salesperson_id"/>
                <filter name="waiting" string="Waiting for Approval" domain="[('state', '=', 'waiting')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="by_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="flowdesk_discount_approval_action" model="ir.actions.act_window">
        <field name="name">Discount Approvals</field>
        <field name="res_model">flowdesk.discount.approval</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
        <field name="context">{'search_default_approved': 1, 'search_default_by_salesperson': 1}</field>
    </record>

    <menuitem id="menu_flowdesk_discount_approvals" name="Discount Approvals"
              parent="menu_flowdesk_reporting" action="flowdesk_discount_approval_action" sequence="10"
              groups="sales_team.group_sale_manager"/>

    <!-- C11: limit on the user -->
    <record id="res_users_view_form_discount" model="ir.ui.view">
        <field name="name">res.users.form.flowdesk.discount</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="other_preferences" position="inside">
                <field name="flowdesk_max_discount"/>
            </group>
        </field>
    </record>

    <!-- C11: status, lines over the limit highlighted, approvals log on the quotation -->
    <record id="sale_order_view_form_discount" model="ir.ui.view">
        <field name="name">sale.order.form.flowdesk.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning d-flex align-items-center gap-3" role="alert"
                     invisible="state not in ('draft', 'sent') or not flowdesk_discount_state or flowdesk_discount_state == 'approved'">
                    <field name="flowdesk_discount_state" widget="badge"
                           decoration-danger="flowdesk_discount_state in ('required', 'rejected')"
                           decoration-warning="flowdesk_discount_state == 'waiting'"/>
                    <span>A line discount is above the salesperson's limit. It cannot be sent or confirmed until a sales manager approves it.</span>
                    <button name="action_flowdesk_request_approval" type="object" class="btn btn-secondary"
                            string="Request Approval" invisible="flowdesk_discount_state != 'required'"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-danger">flowdesk_over_limit</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='display_type']" position="after">
                <field name="flowdesk_over_limit" column_invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Discount Approvals" name="flowdesk_discount_approvals"
                      invisible="not flowdesk_approval_ids">
                    <field name="flowdesk_approval_ids" readonly="1">
                        <list>
                            <field name="salesperson_id"/>
                            <field name="max_discount"/>
                            <field name="approver_id"/>
                            <field name="decision_date"/>
                            <field name="comment"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
