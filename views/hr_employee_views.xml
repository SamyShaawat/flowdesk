<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- C6: commission rate on the employee -->
    <record id="hr_employee_view_form_commission" model="ir.ui.view">
        <field name="name">hr.employee.form.flowdesk.commission</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="after">
                <group name="flowdesk_commission" string="Sales Commission">
                    <field name="flowdesk_commission_rate"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
