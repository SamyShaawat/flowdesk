<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- N1: cancel reasons (managed by sales managers) -->
    <record id="flowdesk_cancel_reason_view_list" model="ir.ui.view">
        <field name="name">flowdesk.cancel.reason.list</field>
        <field name="model">flowdesk.cancel.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="flowdesk_cancel_reason_action" model="ir.actions.act_window">
        <field name="name">Cancel Reasons</field>
        <field name="res_model">flowdesk.cancel.reason</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_flowdesk_cancel_reasons" name="Cancel Reasons"
              parent="menu_flowdesk_config" action="flowdesk_cancel_reason_action" sequence="10"
              groups="sales_team.group_sale_manager"/>

    <!-- N1: cancel popup -->
    <record id="flowdesk_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">flowdesk.cancel.wizard.form</field>
        <field name="model">flowdesk.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Quotation">
                <field name="order_ids" invisible="1"/>
                <field name="has_confirmed_order" invisible="1"/>
                <div class="alert alert-warning fw-bold" role="alert" invisible="not has_confirmed_order">
                    This is a confirmed order. Related documents might be affected by the cancellation.
                </div>
                <group>
                    <field name="reason_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="note" placeholder="Optional details"/>
                </group>
                <footer>
                    <button string="Cancel Quotation" name="action_cancel_orders" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- N1: Cancel button goes through the wizard; mass cancel asks for the reason too -->
    <record id="sale_order_view_form_flowdesk_cancel" model="ir.ui.view">
        <field name="name">sale.order.form.flowdesk.cancel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_cancel" position="attributes">
                <attribute name="name">action_flowdesk_cancel</attribute>
                <attribute name="confirm"></attribute>
            </button>
            <xpath expr="//field[@name='partner_id']/ancestor::group[1]" position="inside">
                <field name="flowdesk_cancel_reason_id" invisible="state != 'cancel' or not flowdesk_cancel_reason_id"/>
                <field name="flowdesk_cancel_note" invisible="state != 'cancel' or not flowdesk_cancel_note"/>
            </xpath>
        </field>
    </record>

    <record id="mass_cancel_orders_view_form_flowdesk" model="ir.ui.view">
        <field name="name">sale.mass.cancel.orders.form.flowdesk</field>
        <field name="model">sale.mass.cancel.orders</field>
        <field name="inherit_id" ref="sale.mass_cancel_orders_view_form"/>
        <field name="arch" type="xml">
            <footer position="before">
                <group>
                    <field name="flowdesk_reason_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                    <field name="flowdesk_note" placeholder="Optional details"/>
                </group>
            </footer>
        </field>
    </record>

    <!-- N1: report of cancelled quotations -->
    <record id="sale_order_view_search_flowdesk_cancelled" model="ir.ui.view">
        <field name="name">sale.order.search.flowdesk.cancelled</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="flowdesk_cancel_reason_id"/>
                <group>
                    <filter name="by_reason" string="Cancel Reason" context="{'group_by': 'flowdesk_cancel_reason_id'}"/>
                    <filter name="by_salesperson" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="by_month" string="Month" context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_order_view_pivot_flowdesk_cancelled" model="ir.ui.view">
        <field name="name">sale.order.pivot.flowdesk.cancelled</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Cancelled Quotations">
                <field name="flowdesk_cancel_reason_id" type="row"/>
                <field name="date_order" interval="month" type="col"/>
                <field name="amount_total" type="measure" string="Lost Amount"/>
            </pivot>
        </field>
    </record>

    <record id="sale_order_view_graph_flowdesk_cancelled" model="ir.ui.view">
        <field name="name">sale.order.graph.flowdesk.cancelled</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph string="Cancelled Quotations" type="bar">
                <field name="flowdesk_cancel_reason_id"/>
                <field name="amount_total" type="measure" string="Lost Amount"/>
            </graph>
        </field>
    </record>

    <record id="flowdesk_cancelled_quotations_action" model="ir.actions.act_window">
        <field name="name">Cancelled Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('state', '=', 'cancel')]</field>
        <field name="search_view_id" ref="sale_order_view_search_flowdesk_cancelled"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('sale_order_view_pivot_flowdesk_cancelled')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('sale_order_view_graph_flowdesk_cancelled')})]"/>
    </record>

    <menuitem id="menu_flowdesk_cancelled_quotations" name="Cancelled Quotations"
              parent="menu_flowdesk_reporting" action="flowdesk_cancelled_quotations_action" sequence="20"
              groups="sales_team.group_sale_salesman"/>
</odoo>
